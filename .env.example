# --- Database ---
# PostgreSQL connection string (e.g. from Supabase, Neon, Railway, Render)
DATABASE_URL="postgresql://user:password@host:5432/healthcare_db?schema=public"

# --- Auth ---
# Any long random string. Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-secret"

# --- LLM (Groq — free tier, no credit card required) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Email (SMTP — works with SendGrid, Mailgun, Gmail app password, etc.) ---
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="apikey"
SMTP_PASS="your-smtp-password-or-api-key"
SMTP_FROM="clinic@example.com"

# --- Google Calendar OAuth2 ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxxxxxx"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/calendar/oauth/callback"

# --- Cron protection ---
# Any long random string; sent as "Authorization: Bearer <CRON_SECRET>"
# by your scheduler when calling /api/cron/* routes.
CRON_SECRET="replace-with-another-long-random-secret"
